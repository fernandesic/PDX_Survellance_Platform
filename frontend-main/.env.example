# ==============================================================================
# WHO/PDX Frontend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git. Only .env.example is committed.
#
#  ⚠️  EVERY `VITE_`-prefixed var is COMPILED INTO THE PUBLIC BUNDLE at build
#     time. Anyone who opens the site can read its value. A `VITE_` var is
#     PUBLIC, FOREVER. Never put a real secret behind a `VITE_` prefix.
#     If a value needs to be secret, put it in backend-main/.env (no VITE_
#     prefix) and add a backend proxy endpoint — see handoff-cleanup/env-security.md.
# ==============================================================================

# ─── API endpoints (public config) ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000
VITE_INTEGRATION_API=http://localhost:8000/api/v1/integration

# ─── Dev toggles ─────────────────────────────────────────────────────────────
VITE_DEBUG=false

# ─── Supabase (anon/publishable key only — RLS MUST be enabled on every table)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ⚠️  FORBIDDEN — do NOT set the following. They were removed because a Supabase
# login (email+password) or service-role key in the client is a full breach.
# If a flow needs elevated access, add a backend endpoint that performs the
# privileged Supabase call server-side (see env-security.md Pattern B):
# VITE_SUPABASE_BRIDGE_EMAIL=    # ← do not set
# VITE_SUPABASE_BRIDGE_PASSWORD= # ← do not set

# ─── ArcGIS ──────────────────────────────────────────────────────────────────
# Referenced by maps (14+ files). Provide a domain-restricted ArcGIS API key.
# Restrict the key in the ArcGIS Developer dashboard to our origin(s); a leaked
# unrestricted key is abusable.
VITE_ARCGIS_API_KEY=your-arcgis-api-key

# ─── OAuth (public by design) ────────────────────────────────────────────────
# Google OAuth client IDs are public — designed to be embedded in clients.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Build metadata ──────────────────────────────────────────────────────────
# Mirrors NODE_ENV when set; mostly cosmetic for in-app version banners.
VITE_NODE_ENV=development

# ⚠️  DECOMMISSIONED — do NOT add these back as VITE_ vars. Code that used to
# read them has been removed (env-security.md cleanup). If a future feature
# needs FIRMS / OpenWeather / Mapbox / Windy / a paid outbreak feed, route
# the call through a backend proxy so the key stays server-side:
#   VITE_FIRMS_API_KEY            → use backend proxy + rotate at NASA FIRMS
#   VITE_OPENWEATHER_API_KEY      → use backend proxy + rotate at OpenWeather
#   VITE_MAPBOX_ACCESS_TOKEN      → if re-introduced, must be domain-restricted
#                                   in the Mapbox dashboard (Pattern C)
#   VITE_WINDY_API_KEY            → use backend proxy
#   VITE_OUTBREAK_API_KEY         → outbreakService.ts now calls the public
#                                   disease.sh endpoint; no Bearer token needed
#   VITE_OUTBREAK_API_BASE        → removed — disease.sh URL is inlined in code

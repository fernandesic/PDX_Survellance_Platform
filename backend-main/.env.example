# ==============================================================================
# WHO/PDX Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Only .env.example is committed.
# ==============================================================================

# ─── Core Django ──────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-new-key-with-get_random_secret_key
DEBUG=False
DJANGO_ENV=local
ALLOWED_HOSTS=datarepr.duckdns.org,whodata.duckdns.org

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Email — SMTP ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── Email — SendGrid (Web API v3) ───────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=https://whodata.duckdns.org

# ─── SSO — Microsoft Azure AD (Entra ID) ─────────────────────────────────────
AZURE_AD_CLIENT_ID=your-azure-app-client-id
AZURE_AD_CLIENT_SECRET=your-azure-app-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# ─── Production Security (set these ONLY in production) ──────────────────────
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# ─── Celery / Redis ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_POOL=solo

# ─── External APIs ───────────────────────────────────────────────────────────
WHONGHUB_API_TOKEN=your-kobotoolbox-api-token
WHONGHUB_FIELD_REPORTS_DATASET_ID=your-dataset-id
GLOBAL_SERVICE_NAME=drivequick

# ─── HDIS ─────────────────────────────────────────────────────────────────────
HDIS_RETENTION_DAYS=90

# ─── Power Automate ──────────────────────────────────────────────────────────
POWER_AUTOMATE_WEBHOOK_EMAIL=your-power-automate-email

# ─── Alert Notifications (sentinel/agent_classifier.py) ──────────────────────
ALERT_NOTIFY_EMAILS=officer1@who.int,officer2@who.int
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ─── Seed Users (only used by: python manage.py seed_users) ───────────────────
SEED_SUPERADMIN_PASSWORD=change-me-on-first-run
SEED_ADMIN_PASSWORD=change-me-on-first-run
SEED_USER_PASSWORD=change-me-on-first-run
SEED_SUPPLIER_PASSWORD=change-me-on-first-run
SEED_JUNIOR_PASSWORD=change-me-on-first-run

# ─── LLM client (hdis/llm_client.py) ─────────────────────────────────────────
# Defaults are local Ollama; override per deployment.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT=60
LLM_RETRY_ATTEMPTS=2

# ─── WBEPI ────────────────────────────────────────────────────────────────────
# Prewarm the WBEPI data layer at startup. Set to 1/true to enable.
WBEPI_PREWARM=0

# ─── LLM client — cloud fallback (hdis/llm_client.py) ────────────────────────
# Optional. Set LLM_FALLBACK_PROVIDER to enable automatic failover when the
# primary LLM is unreachable. Leave empty to disable fallback.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# ─── Agent LLM — dedicated cloud config (sentinel/agent_classifier.py) ───────
# Used independently of LLM_* so the sensitive agent pipeline can run on a
# cloud model while LLM_* stays local. Falls back to Ollama defaults if unset.
AGENT_LLM_PROVIDER=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT=60

# ─── Sentinel / outbreak external data sources ───────────────────────────────
# All optional. Adaptors that don't find a key emit is_healthy()=False and
# skip their fetch (no fake data — see outbreak/adaptors/transmission_drivers.py).
OUTBREAK_ACLED_EMAIL=
OUTBREAK_ACLED_API_KEY=
OUTBREAK_GFW_API_KEY=
OUTBREAK_HDX_API_KEY=
OUTBREAK_NASA_POWER_API_KEY=

# ─── Telegram bot (sentinel/telegram_bot.py) ─────────────────────────────────
# Inbound webhook handler for on-demand country briefings. The agent alert
# pipeline uses ALERT_TELEGRAM_* above for outbound; these are for inbound.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ─── KoboToolbox CHW ingestion (kobo/) ───────────────────────────────────────
# Used by kobo.ingestion to poll Kobo for new CHW field submissions and by
# kobo.views to validate inbound webhooks. KOBO_API_TOKEN is sensitive.
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_ASSET_ID=
KOBO_API_TOKEN=
KOBO_WEBHOOK_SECRET=
